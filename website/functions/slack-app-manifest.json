{
    "display_information": {
        "name": "Telos Waitlist Notifier",
        "description": "Sends notifications to Slack when someone joins the Telos waitlist",
        "background_color": "#0a0a0a"
    },
    "features": {
        "bot_user": {
            "display_name": "Telos Notifier",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write"
            ]
        }
    },
    "settings": {
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "is_hosted": false,
        "token_rotation_enabled": false
    }
}
