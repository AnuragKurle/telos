# Server Configuration
PORT=8080
NODE_ENV=development

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GEMINI_SECRET_NAME=GEMINI_API_KEY

# Development Settings
LOG_LEVEL=debug

# Rate Limiting (per user)
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_PER_DAY=2000

# Client Version (minimum required)
MIN_CLIENT_VERSION=0.1.0

# Dodo Payments Configuration
# Get these from your Dodo Payments Dashboard
DODO_PAYMENTS_API_KEY=your_api_key_here
DODO_PRODUCT_ID_MONTHLY=pdt_your_monthly_product_id
DODO_WEBHOOK_SECRET=your_webhook_secret_here
DODO_ENV=test_mode
FRONTEND_URL=https://telos.app

# SendGrid Email Configuration
SENDGRID_API_KEY_SECRET_NAME=SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=reports@telos.dev
SENDGRID_FROM_NAME=Telos Screen Tracker

# Portkey AI Configuration (for observability)
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_VIRTUAL_KEY=your-portkey-virtual-key-here

# Sentry Error Tracking
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=production

# Slack Alerts (for monitoring)
SLACK_ALERTS_WEBHOOK=your-slack-alerts-webhook-url-here

