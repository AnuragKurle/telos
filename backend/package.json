{
  "name": "telos-backend",
  "version": "0.1.0",
  "description": "Telos backend API - handles screenshot analysis via Gemini",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "setup": "node setup-firestore-prompts.js",
    "setup:slack": "node setup-slack-secrets.js",
    "check:slack": "node setup-slack-secrets.js check",
    "test:slack": "node setup-slack-secrets.js test",
    "test": "echo \"Error: no test specified\" && exit 1"
