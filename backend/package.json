  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "^7.1.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^7.99.0",
    "@sentry/profiling-node": "^7.99.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dodopayments": "^2.14.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^12.0.0",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "multer": "^1.4.5-lts.1",
    "portkey-ai": "^3.0.1"
