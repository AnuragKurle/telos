<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" 
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.telos.tracker</string>
    
    <key>ProgramArguments</key>
    <array>
        <!-- This will be replaced by service_macos.py with actual paths -->
        <string>/Applications/Telos.app/Contents/MacOS/Telos</string>
        <string>service-console</string>
    </array>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/tmp/telos.log</string>
    
    <key>StandardErrorPath</key>
    <string>/tmp/telos.error.log</string>
    
    <key>WorkingDirectory</key>
    <string>~</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>

